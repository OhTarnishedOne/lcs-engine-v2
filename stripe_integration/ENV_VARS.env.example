# ─────────────────────────────────────────────
# Stripe — add to backend .env (Railway)
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...          # or sk_test_... for testing
STRIPE_WEBHOOK_SECRET=whsec_...        # from Stripe Dashboard → Webhooks
STRIPE_PRO_PRICE_ID=price_...          # create a $20/month recurring price in Stripe
FRONTEND_URL=https://lcsengine.com     # used for checkout success/cancel redirect URLs

# ─────────────────────────────────────────────
# No frontend env vars needed for Stripe.
# The checkout redirect is handled server-side.
# ─────────────────────────────────────────────
